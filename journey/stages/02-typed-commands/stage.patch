+
+
+@dataclass(frozen=True, slots=True)
+class SetString:
+    key: bytes
+    value: bytes
+    only_if: Literal["nx", "xx"] | None = None
+    expire_ms: int | None = None
+
+
+@dataclass(frozen=True, slots=True)
+class GetString:
+    key: bytes
+
+
+@dataclass(frozen=True, slots=True)
+class Delete:
