+
+
+@dataclass(frozen=True, slots=True)
+class ListRange:
+    key: bytes
+    start: int
+    stop: int
+
+
+@dataclass(frozen=True, slots=True)
+class SetAdd:
+    key: bytes
+    members: tuple[bytes, ...]
+
+
+@dataclass(frozen=True, slots=True)
+class SetRemove:
+    key: bytes
+    members: tuple[bytes, ...]
+
+
+@dataclass(frozen=True, slots=True)
+class SetIsMember:
