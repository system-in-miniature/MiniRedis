+    amount: int
+
+
+@dataclass(frozen=True, slots=True)
+class HashSet:
+    key: bytes
+    pairs: tuple[tuple[bytes, bytes], ...]
+
+
+@dataclass(frozen=True, slots=True)
+class HashGet:
